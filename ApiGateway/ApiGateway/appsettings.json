{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "user-service-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/User/{**catch-all}"
        }
      },
      "doc-service-route": {
        "ClusterId": "doc-cluster",
        "Match": {
          "Path": "/api/Document/{**catch-all}"
        }
      },
      "doc-service-reports": {
        "ClusterId": "doc-cluster",
        "Match": {
          "Path": "/api/Report/{**catch-all}"
        }
      },
      "user-swagger-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/swagger/user-service/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/user-service" },
          { "PathPrefix": "/swagger" }
        ]
      },
      "doc-swagger-route": {
        "ClusterId": "doc-cluster",
        "Match": {
          "Path": "/swagger/doc-service/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/doc-service" },
          { "PathPrefix": "/swagger" }
        ]
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://user-service:8080" }
        }
      },
      "doc-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://doc-service:8080" }
        }
      }
    }
  }
}

